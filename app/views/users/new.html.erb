<%= form_with model: @user do |form| %>
  <div>
  <%= form.label :username, value: "Your user name here:" %>
  <%= form.text_field :username, value: "Rob" %>
  </div>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, placeholder: "example@example.com"  %>
  </div>
  <div>
    <%= form.label :email_confirmation %>
    <%= form.email_field :email_confirmation, placeholder: "example@example.com" %>
  </div>
  <div>
    <%= form.label :password %>
    <%= form.password_field :password, in: 6..20 %>
  </div>
  <div>
    <%= form.label :password_confirmation %>
    <%= form.password_field :password_confirmation, in: 6..20 %>
  </div>
  <%= form.submit %>
<% end %>